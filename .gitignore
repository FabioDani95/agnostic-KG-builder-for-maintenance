# Paper workspace: frozen experiment evidence is versioned, local stores are not.
paper/experiments/**/operational.db
paper/experiments/**/operational.db-*
paper/experiments/**/raw/
paper/experiments/**/incoming/
paper/experiments/**/*.lock

# V3 campaign: PDFs and heavy run state stay local; graphs, reports, gold and KPIs are versioned.
campaign/*/manual.pdf
campaign/*/runs*/*/state/
campaign/*/runs*/*/provider_responses/
campaign/*/runs*/v22/operational.db*
campaign/*/runs*/v22/raw/
campaign/*/runs*/v22/incoming/
campaign/real_call_budget.jsonl.lock
campaign/results/judge/
# Iteration probes and development runs under results/: heavy state and provider archives stay local.
campaign/results/**/state/
campaign/results/**/provider_responses/
campaign/results/iteration_F/*_provider/

# Local web interface: uploaded manuals, runs started from the UI, caches, frontend build.
workspace/
frontend/node_modules/
frontend/dist/
frontend/*.tsbuildinfo
