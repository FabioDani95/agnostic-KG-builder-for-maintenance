.env
.env.*
!.env.example

# Local PDF manuals (candidates for new campaign manuals).
manuals/

__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
tmp/
.vscode/
.idea/
.DS_Store

# Local AI-tool state.
.claude/
.codex/

# Private manuscript workspace: preserve locally, never publish with the code.
/paper/

# V3 campaign: PDFs and heavy run state stay local; graphs, reports, gold and KPIs are versioned.
campaign/*/manual.pdf
campaign/*/runs*/*/state/
campaign/*/runs*/*/provider_responses/
campaign/*/runs*/v22/operational.db*
campaign/*/runs*/v22/raw/
campaign/*/runs*/v22/incoming/
campaign/real_call_budget.jsonl.lock
campaign/results/judge/
# Iteration probes and development runs under results/: heavy state and provider archives stay local.
campaign/results/**/state/
campaign/results/**/provider_responses/
campaign/results/iteration_F/*_provider/

# Local web interface: uploaded manuals, runs started from the UI, caches, frontend build.
workspace/
frontend/node_modules/
frontend/dist/
frontend/*.tsbuildinfo

# Local runs and audit workspaces, intentionally outside the shared source tree.
# Tracked frozen evidence remains versioned; ignore rules never untrack files.
/runs/
/experiments/
/review/
/data/provider_responses/
/data/raw/
/data/incoming/
/data/operational.db*

# Local diagnostics and coverage output.
*.log
frontend/coverage/
frontend/test-results/
