OPENAI_API_KEY=replace-me
KG_GENERATION_PROVIDER=openai
KG_GENERATION_MODEL=gpt-5.6-terra
KG_EMBEDDING_PROVIDER=openai
KG_EMBEDDING_MODEL=replace-with-qualified-embedding-model
# Optional for compatible local/remote endpoints; omit for provider default.
# KG_GENERATION_BASE_URL=http://127.0.0.1:8001/v1
# KG_EMBEDDING_BASE_URL=http://127.0.0.1:8002/v1
# Legacy generation-only fallback; do not use for embeddings.
# MODEL_NAME=gpt-5.6-terra

# Trusted-local storage and request limits (bytes).
KG_OPERATIONAL_DB=data/operational.db
KG_RAW_DIR=data/raw
KG_INCOMING_DIR=data/incoming
KG_MAX_UPLOAD_BYTES=52428800
KG_MAX_BODY_BYTES=1048576
KG_MAX_REQUEST_BYTES=54525952
KG_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
KG_ALLOWED_HOSTS=127.0.0.1,localhost
